/**
 * Root-owned host installation for the st, reusing upstream's reviewed host artifacts
 * (bin/cli/host-maintenance.ts): pinned Node and backup helpers, nightly backup timer,
 * AppArmor policy, Caddy service and snippets, and the deployment user's boot unit.
 * Only the gateway entrypoint differs: deploy/st/Caddyfile plus a systemd drop-in
 * with this host's names. Runs from a clean root-owned checkout:
 *
 *   node deploy/st/host-install.mts install|verify /root/.config/slk/host.env <node-binary> <site-host> <cms-host> <tls>
 */
import { createHash } from "node:crypto";
import { spawnSync } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { join, resolve } from "node:path";
import { loadHostSettings } from "../../bin/cli/host-configuration.ts";
import { HOST_LOGGING_PATHS, RETIRED_LOGGING_PATHS } from "../../bin/cli/host-logging.ts";
import {
  HOST_NODE,
  hostArtifacts,
  installApplicationUnit,
  installHostArtifact,
  verifyHostArtifact,
  type HostArtifact,
} from "../../bin/cli/host-maintenance.ts";

const root = resolve(import.meta.dirname, "../..");
const hash = (bytes: Buffer) => createHash("sha256").update(bytes).digest("hex");

function run(tool: string, args: string[]) {
  const result = spawnSync(tool, args, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
  if (result.status !== 0) throw new Error(`Host operation failed: ${tool} ${args.join(" ")}`);
  return result.stdout;
}

export function stArtifacts(
  files: HostArtifact[],
  gateway: { site: string; cms: string; tls: string },
  caddyGid: number,
): HostArtifact[] {
  const hostname = /^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9-]{2,63}$/;
  if (!hostname.test(gateway.site) || !hostname.test(gateway.cms) || gateway.site === gateway.cms)
    throw new Error("Website and CMS need two distinct lowercase DNS hostnames");
  if (gateway.tls !== "internal" && !/^[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$/.test(gateway.tls))
    throw new Error("TLS must be an ACME contact email address or 'internal'");
  const entrypoint = files.find((file) => file.path === "/etc/caddy/Caddyfile");
  if (!entrypoint) throw new Error("Upstream host artifacts no longer contain the Caddy entrypoint");
  entrypoint.bytes = readFileSync(join(root, "deploy/st/Caddyfile"));
  if (entrypoint.gid !== caddyGid) throw new Error("Unexpected Caddy entrypoint ownership");
  const dropIn = [
    "# Generated by deploy/st/host-install.mts; host names of this deployment.",
    "[Service]",
    `Environment=SLK_CADDY_SITE_HOST=${gateway.site}`,
    `Environment=SLK_CADDY_CMS_HOST=${gateway.cms}`,
    `Environment=SLK_CADDY_WEBSITE_ORIGIN=https://${gateway.site}`,
    `Environment=SLK_CADDY_CMS_ORIGIN=https://${gateway.cms}`,
    `Environment=SLK_CADDY_TLS=${gateway.tls}`,
    "",
  ].join("\n");
  return [
    ...files,
    {
      path: "/etc/systemd/system/caddy.service.d/slk-st.conf",
      bytes: Buffer.from(dropIn),
      mode: 0o644,
      uid: 0,
      gid: 0,
    },
  ];
}

function main() {
  const [action, config, nodeBinary, site, cms, tls] = process.argv.slice(2);
  if (!["install", "verify"].includes(action ?? "") || !config || !nodeBinary || !site || !cms || !tls)
    throw new Error("Usage: host-install.mts install|verify <host.env> <node-binary> <site-host> <cms-host> <tls>");
  const settings = loadHostSettings(config);
  if (process.arch !== HOST_NODE.arch) throw new Error("This reviewed host profile requires Linux x64");
  if (settings.loggingConfig) throw new Error("Central logging is installed with upstream's slk host install");
  const status = run("git", ["-c", `safe.directory=${root}`, "-C", root, "status", "--porcelain"]);
  if (status.trim()) throw new Error("Install only from a clean, reviewed checkout");
  if ([...HOST_LOGGING_PATHS, ...RETIRED_LOGGING_PATHS].some((path) => existsSync(path)))
    throw new Error("Logging artifacts exist; manage them with upstream's slk host install");
  const caddyGid = Number(run("getent", ["group", "caddy"]).trim().split(":")[2]);
  if (!Number.isInteger(caddyGid) || caddyGid <= 0) throw new Error("The caddy group is required");
  const binary = readFileSync(nodeBinary);
  if (hash(binary) !== HOST_NODE.binarySha256) throw new Error("Node binary differs from the reviewed runtime");
  const files = stArtifacts(hostArtifacts(root, settings, config, caddyGid), { site, cms, tls }, caddyGid);
  files.unshift({ path: "/usr/local/lib/slk/node", bytes: binary, mode: 0o755, uid: 0, gid: 0 });
  if (action === "install") {
    for (const file of files) {
      if (file.uid === 0) installHostArtifact(file);
      else installApplicationUnit(file, settings);
    }
    const user = [
      "-u",
      settings.user,
      "--",
      "env",
      `XDG_RUNTIME_DIR=/run/user/${settings.uid}`,
      `DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${settings.uid}/bus`,
      "systemctl",
      "--user",
    ];
    run("systemctl", ["daemon-reload"]);
    run("runuser", [...user, "daemon-reload"]);
    run("runuser", [...user, "enable", "slk.service"]);
    run("systemctl", ["enable", "--now", "staedtechallenge-backup.timer"]);
  }
  const results = files.map((file) => ({
    path: file.path,
    sha256: hash(file.bytes),
    matches: verifyHostArtifact(file),
  }));
  const ok = results.every((result) => result.matches);
  console.log(
    JSON.stringify(
      { action, revision: run("git", ["-C", root, "rev-parse", "HEAD"]).trim(), ok, files: results },
      null,
      2,
    ),
  );
  if (!ok) throw new Error("Installed host artifacts differ from this checkout");
}

if (process.argv[1] && resolve(process.argv[1]) === resolve(import.meta.filename)) {
  try {
    main();
  } catch (error) {
    console.error(error instanceof Error ? error.message : "Host installation failed");
    process.exitCode = 1;
  }
}
